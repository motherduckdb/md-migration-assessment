{
  "name": "md-migration-assessment-dive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The md-assess dashboard, authored as a MotherDuck Dive. `npm run dev` previews it against a local collection; `npm run build` emits the local-mode bundle into the Python package; `npm run bundle` emits the Dive source that `md-assess publish` uploads.",
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsx scripts/third-party-notices.ts",
    "bundle": "tsx scripts/bundle-dive.ts",
    "typecheck": "tsc --noEmit",
    "notices": "tsx scripts/third-party-notices.ts",
    "test": "tsx --test runtime/*.test.ts"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "~3.7.0"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.4-r.1",
    "@types/d3": "^7.4.3",
    "@types/node": "^22.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "esbuild": "^0.28.0",
    "tsx": "^4.21.0",
    "typescript": "^5.6.0",
    "vite": "^8.1.5"
  }
}
